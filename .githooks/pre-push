#!/usr/bin/env bash
ZERO='0000000000000000000000000000000000000000'
refs="$(cat)"

credited="$(
  while read -r _ local_sha _ remote_sha; do
    [ -n "$local_sha" ] && [ "$local_sha" != "$ZERO" ] || continue
    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      range="$remote_sha..$local_sha"
    else
      range="origin/main..$local_sha"
    fi
    git log --format='commit %h %s%n%B' "$range" |
      awk '/^commit [0-9a-f]+ / { commit = substr($0, 8); next }tolower($0) ~ /^co-authored-by:.*(claude|anthropic\.com)|generated with \[?claude code/ && commit != "" { print "  " commit; commit = "" }'
  done <<<"$refs"
)"
if [ -n "$credited" ]; then
  printf '\033[31m✗ these commits credit Claude, and commits here credit only people:\033[0m\n%s\n' "$credited"
  printf '\033[2m  reword them without the Co-Authored-By / Generated with Claude Code lines, then push again\033[0m\n'
  exit 1
fi

printf '%s\n' "$refs" | exec "$(git rev-parse --show-toplevel)/scripts/pre-push.sh" "$@"
